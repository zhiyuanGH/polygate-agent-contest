+
+    # PolyGate strips /<app-id> before proxying. FastAPI uses ASGI root_path
+    # to generate Swagger/OpenAPI links with the public prefix. The gateway
+    # supplies this header only for path routes, so legacy host routes still
+    # generate root URLs.
+    public_prefix = re.compile(
+        r"^/(?:[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}|"
+        r"[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?/[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)$"
+    )
+
+    @application.middleware("http")
+    async def polygate_path_prefix(request: Request, call_next):
+        prefix = request.headers.get("x-forwarded-prefix", "")
+        if public_prefix.fullmatch(prefix):
+            request.scope["root_path"] = prefix
+        return await call_next(request)
+
     application.state.store = store
 
+    @application.get("/", include_in_schema=False)
+    def open_documentation():
+        # A relative redirect works through both the path gateway and the
+        # legacy host gateway, so PolyGate's Open app link has a landing page.
+        return RedirectResponse("docs")
+
     @application.exception_handler(UnknownCourt)
